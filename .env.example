# ============================================================
# ChairMatch — Umgebungsvariablen (Vorlage)
# ============================================================
# Kopiere diese Datei als ".env.local" für lokale Entwicklung.
# Für Production: alle Werte in Vercel → Settings → Environment Variables eintragen.
# WICHTIG: .env.local niemals committen!
# ============================================================


# ── SUPABASE ─────────────────────────────────────────────────
# Supabase Dashboard → Project → Settings → API

# Deine Projekt-URL (sieht aus wie: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT-ID.supabase.co

# Anon Key — für Browser/Client-Side, öffentlich sichtbar
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...DEIN_ANON_KEY...

# Service-Role Key — NUR server-seitig, NIEMALS im Browser!
# Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJ...DEIN_SERVICE_ROLE_KEY...


# ── STRIPE ───────────────────────────────────────────────────
# Stripe Dashboard → Developers → API Keys

# Publishable Key — öffentlich (beginnt mit pk_live_ oder pk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_DEIN_PUBLISHABLE_KEY

# Secret Key — NUR server-seitig (beginnt mit sk_live_ oder sk_test_)
STRIPE_SECRET_KEY=sk_test_DEIN_SECRET_KEY

# Webhook Secret — Stripe Dashboard → Webhooks → Signing Secret
# Lokal: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` → gibt whsec_ aus
STRIPE_WEBHOOK_SECRET=whsec_DEIN_WEBHOOK_SECRET

# Abo-Preis-IDs — Stripe Dashboard → Products → jeweiliger Preis → Price ID
# Format: price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_STARTER_PREIS_ID
STRIPE_PRICE_PREMIUM=price_PREMIUM_PREIS_ID
STRIPE_PRICE_GOLD=price_GOLD_PREIS_ID


# ── E-MAIL (Resend) ──────────────────────────────────────────
# resend.com → Dashboard → API Keys → Create API Key
RESEND_API_KEY=re_DEIN_RESEND_API_KEY

# Absender-Adresse für transaktionale E-Mails
# Muss eine verifizierte Domain in Resend sein (z. B. chairmatch.de)
# Format: "Name <adresse@domain.de>"
RESEND_FROM_EMAIL=ChairMatch <noreply@chairmatch.de>


# ── WEB PUSH NOTIFICATIONS (VAPID) ──────────────────────────
# Einmalig generieren mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=DEIN_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=DEIN_VAPID_PRIVATE_KEY
# Deine eigene E-Mail-Adresse (für VAPID-Identifikation)
VAPID_EMAIL=mailto:admin@chairmatch.de


# ── APP URL ──────────────────────────────────────────────────
# Lokal: http://localhost:3000
# Production: https://chairmatch.de (oder deine Vercel-URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── ADMIN & CRON SECRETS ─────────────────────────────────────
# Einmalig für Admin-Promotion-Setup — beliebiger sicherer String (z. B. per `openssl rand -hex 32`)
ADMIN_SETUP_KEY=ein-langer-zufaelliger-geheimstring

# Authentifizierung für automatische Cron-Jobs (z. B. Hard-Delete-Task)
CRON_SECRET=ein-anderer-langer-zufaelliger-geheimstring


# ── ANALYTICS / SEO / GEO (Welle 1) ──────────────────────────
# Schritt-für-Schritt-Anleitung wie du diese Werte holst: siehe SETUP_ACCOUNTS.md

# Google Analytics 4 — Measurement-ID (im Browser sichtbar = OK)
# Format: G-XXXXXXXXXX, holst du dir aus analytics.google.com
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel ID (Facebook/Instagram) — im Browser sichtbar = OK
# Format: 15-16-stellige Zahl, holst du dir aus business.facebook.com → Events Manager
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXX

# Meta Conversions API (CAPI) — Server-Side Pixel, NICHT im Browser exposen
# Im Events Manager → Einstellungen → "Zugriffstoken generieren"
META_CAPI_ACCESS_TOKEN=EAAB_DEIN_LANGER_TOKEN

# Optional: Meta CAPI Test-Event-Code für Staging (TEST12345 o.ä.)
# META_CAPI_TEST_EVENT_CODE=


# ══════════════════════════════════════════════════════════════
# NACHGETRAGEN 2026-08-24 (Delta-Check)
# ══════════════════════════════════════════════════════════════
# Diese Variablen werden im Code gelesen, standen aber in keiner Vorlage.
# Wer nach dieser Datei aufgesetzt hat, bekam ein Projekt, das an Stellen
# still degradiert: NextAuth ohne Secret, SMS-Login ohne Provider,
# Resend-Webhook ohne Signaturpruefung.
#
# Von Vercel selbst gesetzt und deshalb NICHT hier aufgefuehrt:
# NODE_ENV, NEXT_RUNTIME, VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV,
# VERCEL_GIT_COMMIT_SHA.


# ── AUTH (NextAuth v5) ───────────────────────────────────────
# PFLICHT. Ohne Secret startet NextAuth in Produktion nicht.
# Erzeugen mit: openssl rand -base64 32
# NextAuth v5 liest bevorzugt AUTH_SECRET; NEXTAUTH_SECRET bleibt als
# Altlast unterstuetzt (siehe /api/admin/health). Einer von beiden genuegt.
AUTH_SECRET=ein-langer-zufaelliger-geheimstring
# NEXTAUTH_SECRET=identisch-zu-AUTH_SECRET


# ── SMS / TELEFON-VERIFIZIERUNG (Twilio) ─────────────────────
# Optional. Fehlt einer der drei Werte, laeuft /api/auth/phone/send im
# Dev-Modus: der Code wird NICHT verschickt, sondern nur ins Vercel-Log
# geschrieben. Das ist fuer Produktion nicht brauchbar.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=dein-twilio-auth-token
# TWILIO_FROM_NUMBER=+49xxxxxxxxxxx


# ── RESEND (Ergaenzung) ──────────────────────────────────────
# Antwortadresse fuer Newsletter und Benachrichtigungen.
# Default ohne Wert: support@chairmatch.de
# RESEND_REPLY_TO=support@chairmatch.de
#
# Signatur-Secret aus dem Resend-Dashboard (Webhooks). SOLANGE DAS FEHLT,
# akzeptiert /api/newsletter/webhook Events UNVERIFIZIERT — jeder kann dann
# Oeffnungs-/Bounce-Zaehler faelschen und Abonnenten auf 'bounced' setzen.
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx


# ── SENTRY (Fehler-Monitoring) ───────────────────────────────
# Optional. Ohne DSN laeuft @sentry/nextjs im No-op.
# SENTRY_DSN=https://xxxx@oyyyy.ingest.sentry.io/zzzz
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oyyyy.ingest.sentry.io/zzzz


# ── KARTEN ───────────────────────────────────────────────────
# Optional. Im Browser sichtbar — im Google-Cloud-Console unbedingt auf die
# eigenen Domains beschraenken, sonst zahlt man fremde Aufrufe mit.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy...


# ── INDEXIERUNG (IndexNow / Google Indexing API) ─────────────
# Optional. IndexNow-Schluessel wird unter /api/indexnow/key ausgeliefert —
# er ist per Design oeffentlich, aber muss zum Dateinamen passen.
# INDEXNOW_KEY=32-stelliger-hex-string
#
# Service-Account-JSON der Google Indexing API, in EINER Zeile.
# GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON={"type":"service_account",...}


# ── RLS-SICHERHEITSTESTS ─────────────────────────────────────
# Nur lokal, nur fuer ./scripts/rls-security-test.mjs. Zwei echte Testkonten,
# die sich gegenseitig NICHT sehen duerfen. Niemals Produktivkonten.
# RLS_TEST_USER_A_EMAIL=rls-a@example.com
# RLS_TEST_USER_A_PASSWORD=
# RLS_TEST_USER_B_EMAIL=rls-b@example.com
# RLS_TEST_USER_B_PASSWORD=
